<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "unraid-manager">
<!ENTITY author    "FugginOld">
<!ENTITY version   "2026.08.25">
<!ENTITY launch    "Tasks/Fleet">
<!ENTITY pluginURL "https://raw.githubusercontent.com/FugginOld/unraid-link/main/unraid-manager.plg">
<!ENTITY pkgURL    "https://github.com/FugginOld/unraid-link/releases/download/2026.08.25/unraid-manager.txz">
<!ENTITY md5       "00000000000000000000000000000000">
<!ENTITY icon      "icon.png">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" icon="&icon;" min="7.0.0">

<CHANGES>
###2026.08.25###
First skeleton release. Enrolls Unraid peers by address and API key and shows
their live state on a Fleet tab: array state, capacity, versions, unread
notifications and last-seen. Read-only against every peer — this release cannot
change anything on a node it watches.

A node it cannot read reads as "unknown", in its own colour, never as healthy
and never as an error. An array with no disks in it reads as an empty array,
because that is what it is.
</CHANGES>

<FILE Name="/boot/config/plugins/unraid-manager/unraid-manager.txz" Run="upgradepkg --install-new">
<URL>&pkgURL;</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
[ -x /usr/local/emhttp/plugins/unraid-manager/scripts/rc.unraid-manager ] &amp;&amp; /usr/local/emhttp/plugins/unraid-manager/scripts/rc.unraid-manager stop
rm -rf /usr/local/emhttp/plugins/unraid-manager
tar -xJf /boot/config/plugins/unraid-manager/unraid-manager.txz -C /
chmod +x /usr/local/emhttp/plugins/unraid-manager/scripts/rc.unraid-manager
chmod +x /usr/local/emhttp/plugins/unraid-manager/event/started
chmod +x /usr/local/emhttp/plugins/unraid-manager/event/stopping_svcs

# Flash config. Seeded once and never rewritten by an upgrade: db_path is the
# operator's answer and reinstalling must not silently move where the telemetry
# lives. Written with printf, not a heredoc, because this INLINE block is XML
# character data.
mkdir -p /boot/config/plugins/unraid-manager/keys
# /boot is vfat: file modes come from the mount's fmask/dmask, so this chmod is
# either a no-op or "Operation not permitted" depending on the mount options,
# and this block re-runs every boot. Keep it for the hosts where it works;
# suppress the error everywhere else instead of printing on every boot.
chmod 700 /boot/config/plugins/unraid-manager/keys 2>/dev/null || true
if [ ! -f /boot/config/plugins/unraid-manager/manager.cfg ]; then
  printf 'db_path=\npoll_fast=30\npoll_slow=600\n' > /boot/config/plugins/unraid-manager/manager.cfg
fi
[ -f /boot/config/plugins/unraid-manager/nodes.cfg ] || : > /boot/config/plugins/unraid-manager/nodes.cfg

# Retention prune, daily. /etc/cron.d is tmpfs and this block re-runs at boot,
# which is how every Unraid plugin schedules work; update_cron folds it into
# root's crontab.
printf '%s\n' \
  '# Generated by the unraid-manager plugin - removed on plugin uninstall.' \
  '17 4 * * 1-6 /usr/local/emhttp/plugins/unraid-manager/scripts/rc.unraid-manager prune >/dev/null 2>/dev/null' \
  '17 4 * * 0 /usr/local/emhttp/plugins/unraid-manager/scripts/rc.unraid-manager prune-vacuum >/dev/null 2>/dev/null' \
  > /etc/cron.d/unraid-manager
/usr/local/sbin/update_cron

# Start only if the array is up: db_path points at a pool, and starting before
# the pool mounts means the daemon exits on a missing parent directory.
if [ -f /var/local/emhttp/var.ini ] &amp;&amp; grep -q 'mdState="STARTED"' /var/local/emhttp/var.ini; then
  /usr/local/emhttp/plugins/unraid-manager/scripts/rc.unraid-manager start
fi
echo "unraid-manager installed"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
/usr/local/emhttp/plugins/unraid-manager/scripts/rc.unraid-manager stop
removepkg unraid-manager
rm -rf /usr/local/emhttp/plugins/unraid-manager
rm -f /etc/cron.d/unraid-manager
/usr/local/sbin/update_cron
# The flash config, the enrollment keys and the pool database are deliberately
# left in place. They are the operator's data: the registry survives a
# reinstall, and deleting a key file silently would strand a node that is still
# enrolled. Remove them by hand to start clean:
#   rm -rf /boot/config/plugins/unraid-manager
echo "unraid-manager removed. Flash config kept at /boot/config/plugins/unraid-manager"
</INLINE>
</FILE>

</PLUGIN>
